#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# =============================================================================
# S6 long-running service: PostgreSQL + Hindsight API
# =============================================================================

PG_MAJOR="15"
PG_BIN="/usr/lib/postgresql/${PG_MAJOR}/bin"
PGDATA="${PGDATA:-/data/pg}"

# Local model downloads (GGUF + ONNX caches) must survive addon updates.
export HOME="/data/hindsight-home"
mkdir -p "$HOME"

# Load the env written by 30-config.sh and export it to hindsight-api.
# shellcheck source=/dev/null
set -a
[ -f /data/hindsight/env ] && . /data/hindsight/env
set +a

# --- start PostgreSQL -------------------------------------------------------
# A container restart can leave postmaster.pid behind; pg_ctl then refuses to start.
if [ -f "${PGDATA}/postmaster.pid" ] && ! runuser -u postgres -- "${PG_BIN}/pg_isready" -h 127.0.0.1 -q; then
    bashio::log.warning "Removing stale PostgreSQL PID file"
    rm -f "${PGDATA}/postmaster.pid"
fi

bashio::log.info "Starting PostgreSQL ${PG_MAJOR}..."
runuser -u postgres -- "${PG_BIN}/pg_ctl" -D "${PGDATA}" -l /data/pg/server.log start -w -t 60 \
    || bashio::log.fatal "PostgreSQL failed to start"

for _ in $(seq 1 30); do
    if runuser -u postgres -- "${PG_BIN}/pg_isready" -h 127.0.0.1 -q; then break; fi
    sleep 1
done

runuser -u postgres -- "${PG_BIN}/psql" -h 127.0.0.1 -lqt 2>/dev/null | grep -q hindsight \
    || runuser -u postgres -- "${PG_BIN}/createdb" -h 127.0.0.1 hindsight

# pgvector — create it now that PostgreSQL is actually accepting connections.
if ! runuser -u postgres -- "${PG_BIN}/psql" -h 127.0.0.1 -d hindsight -tAc "SELECT 1 FROM pg_extension WHERE extname='vector'" 2>/dev/null | grep -q 1; then
    bashio::log.info "Enabling pgvector extension"
    runuser -u postgres -- "${PG_BIN}/psql" -h 127.0.0.1 -d hindsight -c 'CREATE EXTENSION IF NOT EXISTS vector;' \
        || bashio::log.warning "pgvector unavailable; Hindsight may fall back to built-in search"
fi

# --- start Hindsight --------------------------------------------------------
bashio::log.info "Starting Hindsight API..."
cd /data

exec /opt/hindsight-venv/bin/hindsight-api

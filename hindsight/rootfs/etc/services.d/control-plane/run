#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

# =============================================================================
# S6 long-running service: Hindsight Control Plane (Next.js standalone)
#
# Next.js emits root-absolute asset and API paths (/_next/..., /api/...).
# Home Assistant ingress serves the app under /api/hassio_ingress/<token>/, so
# nginx in front rewrites those paths using the base path discovered from the
# Supervisor at startup. The UI itself listens on a loopback backend port.
# =============================================================================

ENABLE_CP="${control_plane:-true}"
CP_PORT="${control_plane_port:-9999}"
BACKEND_PORT=9998

if [ "${ENABLE_CP}" != "true" ]; then
    bashio::log.info "Control plane disabled (control_plane=false), exiting"
    exit 0
fi

# Wait for the API to answer before serving, so the UI does not open on a
# connection-refused dataplane.
bashio::log.info "Waiting for the Hindsight API on 127.0.0.1:8888..."
for _ in $(seq 1 60); do
    if curl -sf -o /dev/null --max-time 3 http://127.0.0.1:8888/health; then
        bashio::log.info "API is up"
        break
    fi
    sleep 2
done

# The ingress path is unique per installation. Read it from the Supervisor (its
# token is available to every addon) and strip the entry path to get the base.
BASE_PATH=""
if [[ -n "${SUPERVISOR_TOKEN:-}" ]]; then
    INGRESS_URL="$(curl -sf -m 10 -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        http://supervisor/addons/self/info | jq -r '.data.ingress_url // empty' || true)"
    if [[ -n "$INGRESS_URL" ]]; then
        BASE_PATH="$(printf '%s' "$INGRESS_URL" | sed -E 's#/[^/]*$##; s#/$##')"
    fi
fi
bashio::log.info "Control plane ingress base: ${BASE_PATH:-<root>}"

mkdir -p /run/nginx
sed -e "s#__PORT__#${CP_PORT}#g" \
    -e "s#__BACKEND__#${BACKEND_PORT}#g" \
    -e "s#__BASE__#${BASE_PATH}#g" \
    /etc/nginx.conf.template > /run/nginx/hindsight.conf

export PORT="${BACKEND_PORT}"
export HOSTNAME="0.0.0.0"
export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--dns-result-order=ipv4first"
export NODE_ENV=production
export HINDSIGHT_CP_DATAPLANE_API_URL="http://127.0.0.1:8888"
export HINDSIGHT_CP_PORT="${BACKEND_PORT}"

bashio::log.info "Starting Hindsight Control Plane on ${CP_PORT} (nginx -> ${BACKEND_PORT})"
cd /opt/control-plane
node server.js &
CP_PID=$!
trap 'kill "${CP_PID}" 2>/dev/null || true' EXIT

for _ in $(seq 1 30); do
    if curl -sf -o /dev/null --max-time 2 "http://127.0.0.1:${BACKEND_PORT}/dashboard"; then
        break
    fi
    sleep 1
done

exec nginx -c /run/nginx/hindsight.conf -g 'daemon off;'

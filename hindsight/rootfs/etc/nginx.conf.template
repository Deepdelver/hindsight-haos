worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
# Direct access (Open Web UI / host IP): plain proxy, no path rewriting.
server {
    listen __DIRECT_PORT__;
    server_name _;
    proxy_buffering off;
    gunzip on;
    location / {
        proxy_pass http://127.0.0.1:__BACKEND__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}

# Home Assistant ingress: rewrite absolute paths to the runtime ingress base.
server {
    listen __PORT__;
    server_name _;
    proxy_buffering off;
    gunzip on;

    location / {
        proxy_pass http://127.0.0.1:__BACKEND__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Ingress-Path $http_x_ingress_path;
        # Responses must be uncompressed for sub_filter to see the URLs.
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Next.js emits root-absolute asset and API paths. Home Assistant's
        # ingress proxy serves the app under /api/hassio_ingress/<token>/, so
        # every absolute path must be prefixed with the runtime base path.
        sub_filter_once off;
        sub_filter_types text/html text/css text/javascript application/javascript application/json;

        sub_filter 'href="/' 'href="__BASE__/';
        sub_filter "href='/" "href='__BASE__/";
        sub_filter 'src="/' 'src="__BASE__/';
        sub_filter "src='/" "src='__BASE__/";
        sub_filter 'action="/' 'action="__BASE__/';
        sub_filter 'url(/' 'url(__BASE__/';
        sub_filter '"/_next/' '"__BASE__/_next/';
        sub_filter "'/_next/" "'__BASE__/_next/";
        sub_filter '"/api/' '"__BASE__/api/';
        sub_filter "'/api/" "'__BASE__/api/";
        sub_filter '`/api/' '`__BASE__/api/';
        sub_filter '"/v1/' '"__BASE__/v1/';
        sub_filter "'/v1/" "'__BASE__/v1/";
        sub_filter '`/v1/' '`__BASE__/v1/';

        # Only template-literal navigation paths are rewritten. Double-quoted
        # route fragments are also used as API path suffixes (e.g. "/config"),
        # and rewriting those would double-prefix API URLs.
        sub_filter '`/banks' '`__BASE__/banks';
        sub_filter '`/dashboard' '`__BASE__/dashboard';
        sub_filter '`/memories' '`__BASE__/memories';
        sub_filter '`/observations' '`__BASE__/observations';
        sub_filter '`/knowledge-banks' '`__BASE__/knowledge-banks';
        sub_filter '`/mental-models' '`__BASE__/mental-models';
        sub_filter '`/directives' '`__BASE__/directives';
        sub_filter '`/webhooks' '`__BASE__/webhooks';

        # Bank selector parses the current path with /^\/banks\/.../; allow the
        # ingress prefix in front of it.
        sub_filter '^\\/banks\\/' '^.*\\/banks\\/';

        # Next.js client-side navigation cannot handle HA's ingress prefix.
        # Force internal links to do a full page load, which works correctly.
        sub_filter '<head>' '<head><script>var B="__BASE__";function nav(u){u=String(u||"");if(u.indexOf(B)===0){if(location.pathname+location.search!==u){location.href=u;}return true;}if(u.charAt(0)==="/"&&u.indexOf("//")!==0){var t=B+u;if(location.pathname+location.search!==t){location.href=t;}return true;}return false;}document.addEventListener("click",function(e){var a=e.target.closest&&e.target.closest("a[href*=hassio_ingress]");if(a&&!a.target&&nav(a.getAttribute("href"))){e.preventDefault();e.stopPropagation();}},true);["pushState","replaceState"].forEach(function(m){var o=history[m];history[m]=function(s,t,u){if(!nav(u)){return o.apply(this,arguments);}};});</script>';

        proxy_hide_header Content-Security-Policy;
    }
}
}
